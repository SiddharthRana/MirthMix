{
  "name": "@mirthmix/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/build.mjs --check",
    "typecheck": "node scripts/build.mjs && tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build.mjs && vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
