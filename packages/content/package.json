{
  "name": "@mirthmix/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "packs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./packs/*": "./packs/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "validate": "node --experimental-strip-types scripts/content.ts validate",
    "sync": "node --experimental-strip-types scripts/content.ts sync"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vitest": "^5.0.5"
  }
}
