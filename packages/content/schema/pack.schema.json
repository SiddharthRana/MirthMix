{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "const": "would-you-rather"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "categories": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 140
              },
              "tier": {
                "type": "string",
                "enum": [
                  "free",
                  "premium"
                ]
              },
              "ageRating": {
                "type": "string",
                "enum": [
                  "all",
                  "13+"
                ]
              },
              "region": {
                "type": "string",
                "enum": [
                  "global",
                  "in"
                ]
              },
              "contentNote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 140
              }
            },
            "required": [
              "id",
              "name",
              "description",
              "tier",
              "ageRating",
              "region"
            ],
            "additionalProperties": false
          }
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^wyr-[a-z0-9-]+-\\d{3}$"
              },
              "category": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "a": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "b": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              }
            },
            "required": [
              "id",
              "category",
              "a",
              "b"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mode",
        "version",
        "categories",
        "items"
      ],
      "additionalProperties": false
    }
  ]
}
